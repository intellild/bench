{
  "name": "loader-cache-storage-bench",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "generate": "node generate-fixtures.mjs",
    "benchmark": "zx run-benchmark.mjs",
    "benchmark:make-cache": "zx bench-persist-make-vs-loader-cache.mjs",
    "bench:json": "RSPACK_REPO=./rspack-json RSPACK_LOADER_CACHE_BENCH_LABEL=json node bench-loader-cache.mjs > json-result.json",
    "bench:rkyv": "RSPACK_REPO=./rspack-rkyv RSPACK_LOADER_CACHE_BENCH_LABEL=rkyv node bench-loader-cache.mjs > rkyv-result.json",
    "bench:single-loader": "RSPACK_REPO=./rspack-single-loader RSPACK_LOADER_CACHE_BENCH_LABEL=single-loader node bench-loader-cache.mjs > single-loader-result.json",
    "bench:storage": "RSPACK_REPO=./rspack-storage RSPACK_LOADER_CACHE_BENCH_LABEL=rspack-storage node bench-loader-cache.mjs > storage-result.json",
    "compare": "node compare-loader-cache-results.mjs json-result.json rkyv-result.json single-loader-result.json storage-result.json"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-loader": "^10.1.1",
    "zx": "^8.8.5"
  }
}
